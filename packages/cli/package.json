{
  "name": "@openscout/scout",
  "version": "0.5.1",
  "mcpName": "io.github.openscout-app/scout",
  "description": "Coordinate Claude Code, Codex, Cursor, OpenCode, Kimi, Grok, Pi, and Devin agents with local-first messaging, task orchestration, and MCP.",
  "keywords": [
    "openscout",
    "ai-agents",
    "coding-agents",
    "agent-coordination",
    "multi-agent",
    "local-first",
    "control-plane",
    "agent-broker",
    "developer-tools",
    "cli",
    "mcp",
    "acp",
    "claude-code",
    "codex",
    "cursor",
    "bun",
    "agent-orchestration",
    "multi-agent-orchestration",
    "agent-messaging",
    "mcp-server",
    "model-context-protocol",
    "opencode",
    "kimi",
    "grok",
    "pi-agent",
    "devin",
    "hermes-agent",
    "claude",
    "opus",
    "fable",
    "sonnet",
    "haiku",
    "gpt",
    "glm",
    "qwen",
    "minimax",
    "deepseek",
    "nemotron"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openscout-app/scout.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/openscout-app/scout/issues"
  },
  "homepage": "https://openscout.app",
  "bin": {
    "scout": "./bin/scout",
    "openscout-runtime": "./bin/openscout-runtime.mjs"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "NOTICE"
  ],
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "bonjour-service": "^1.4.4",
    "picomatch": "^4.0.4",
    "reflect-metadata": "0.2.2",
    "ws": "^8.18.3"
  },
  "scripts": {
    "build": "bun run --cwd ../protocol build && bun run --cwd ../runtime build && node ./scripts/build.mjs",
    "dev": "bun ./src/main.ts",
    "test:happy": "node --test test/*.test.mjs",
    "prepack": "bun run build && node ../../scripts/prepare-publish-manifest.mjs .",
    "postpack": "node ../../scripts/restore-publish-manifest.mjs .",
    "postpublish": "node ../../scripts/restore-publish-manifest.mjs .",
    "check": "tsc -p tsconfig.json",
    "test:source": "bun ./scripts/test-source.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22",
    "bun-types": "^1.3.11",
    "typescript": "^5",
    "@openscout/runtime": "workspace:*",
    "@modelcontextprotocol/core": "2.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@openscout/protocol": "workspace:*",
    "@trpc/client": "^11.16.0",
    "zod": "4.4.3",
    "@openscout/pairing": "workspace:*"
  }
}
