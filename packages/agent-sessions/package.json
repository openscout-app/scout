  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "prebuild": "bun ../../scripts/generate-runtime-catalog.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json && bun build ./src/adapters/opencode-v2/upstream.ts --target=node --format=esm --outfile ./dist/adapters/opencode-v2/upstream.js",
    "precheck": "bun ../../scripts/generate-runtime-catalog.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src",
    "model-worldview:generate": "bun scripts/generate-model-worldview.ts",
    "model-worldview:check": "bun scripts/check-model-worldview.ts",
    "test:node-opencode-launch-error": "npm run build && node scripts/opencode-node-launch-error-smoke.mjs",
    "adapter:validate-specs": "node ./src/adapters/spec/tools/validate-adapter-specs.mjs",
    "adapter:conformance": "bun ./scripts/adapter-conformance.ts",
    "event-types": "bun ./src/adapters/tools/extract-event-types.ts",
    "codex:extract-protocol": "node ./src/adapters/codex/tools/extract-rust-protocol-spec.mjs",
    "prepack": "npm run build && node ../../scripts/prepare-publish-manifest.mjs .",
    "postpack": "node ../../scripts/restore-publish-manifest.mjs .",
    "postpublish": "node ../../scripts/restore-publish-manifest.mjs ."
  },
