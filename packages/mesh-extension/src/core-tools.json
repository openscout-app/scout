  {
    "name": "ask",
    "title": "Ask",
    "description": "Create a task and return on acceptance. For another mesh machine use on with projectPath. Use exactly one route: to, operator, channel (FYI only), projectPath/capability, ref (unfinished task follow-up), or continue (successor to a finished task). fyi deliberately creates only a message, never a task. cancel requires ref and explicitly cancels; text alone never cancels. Operator tasks request push; operator FYIs push only with notify. defaultAction completes after window seconds (default 1800) if unanswered. Use the returned handle to wait. Automatic harness final answers still complete tasks.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operator": {
          "type": "boolean"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "continue": {
          "type": "string",
          "minLength": 1
        },
        "cancel": {
          "type": "boolean"
        },
        "fyi": {
          "type": "boolean"
        },
        "notify": {
          "type": "boolean"
        },
        "defaultAction": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "permission": {
          "type": "boolean"
        },
        "because": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "image": {
          "description": "Local image path.",
          "type": "string"
        },
        "completion": {
          "description": "Require an explicit final reply; exact local id or session targets only, with a stable requestId.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "explicit"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "relation": {
          "description": "Join child work or continue a parent flight; requires a stable requestId.",
          "type": "object",
          "properties": {
            "parentFlightId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "joined",
                "continuation"
              ]
            }
          },
          "required": [
            "parentFlightId",
            "kind"
          ],
          "additionalProperties": false
        },
        "requestId": {
          "description": "Requester-scoped idempotency key; reuse on retries.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "to": {
          "description": "Agent id, label, sibling, specialist, recent collaborator, target:<name>, or ⌖name.",
          "type": "string",
          "minLength": 1
        },
        "targetSessionId": {
          "type": "string",
          "description": "Exact Scout session to continue: a copyable session address (sess.<token>@<host>, from `scout session address` or a receipt's targetSessionAddress / returnAddress.sessionAddress) or a session id. Agent-card targets create fresh sessions; pass targetSessionId only when you intentionally want prior context from a specific CODEX_THREAD_ID or attached runtime session. An address never falls back to a fresh session."
        },
        "projectPath": {
          "type": "string",
          "minLength": 1,
          "description": "Project root to ask when you do not have a specific agent in mind; pair with harness when the capability matters. Scout resolves or creates the concrete worker and returns durable follow-up handles."
        },
        "on": {
          "description": "Mesh machine to start the session on (e.g. build-host). Requires projectPath, read as a path on that machine (sent as typed, `~` expands there). Starts a fresh session; list machines with whoami or `scout machines`.",
          "type": "string",
          "minLength": 1
        },
        "aliasProject": {
          "description": "Explicit project root for a to=alias:<name> target.",
          "type": "string"
        },
        "aliasHost": {
          "description": "Explicit authority node id/name for a to=alias:<name> target.",
          "type": "string"
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "currentDirectory": {
          "type": "string"
        },
        "senderId": {
          "type": "string"
        },
        "replyToSessionId": {
          "description": "Optional requester session that should receive the eventual reply. When omitted, Codex MCP uses the current CODEX_THREAD_ID when available.",
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workItem": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string"
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "normal",
                "high",
                "urgent"
              ]
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "parentId": {
              "type": "string"
            },
            "acceptanceState": {
              "type": "string",
              "enum": [
                "none",
                "pending",
                "accepted",
                "reopened"
              ]
            },
            "metadata": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false
        },
        "channel": {
          "type": "string"
        },
        "replyMode": {
          "type": "string",
          "enum": [
            "none",
            "inline",
            "notify"
          ],
          "description": "Legacy replyMode='notify' means return on acceptance, unrelated to the operator notify flag. Reply delivery mode (default 'notify'): 'notify' returns durable ids quickly and emits notifications/scout/reply when OPENSCOUT_MCP_ENABLE_NOTIFICATIONS=1 (always on for the hosted bridge), 'inline' waits briefly, and 'none' returns durable ids only."
        },
        "timeoutSeconds": {
          "description": "Caller wait budget in seconds for inline waits only; it never cancels or fails the broker ask.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "runtime": {
          "description": "Shell-safe RuntimeSpec: harness[/model[/effort]], such as codex/gpt-5.6-sol/xhigh.",
          "type": "string"
        },
        "profile": {
          "description": "Runtime preset base. Explicit harness/model/reasoningEffort fields may override compatible dimensions.",
          "type": "string",
          "enum": [
            "fable",
            "kimi",
            "grok",
            "opus",
            "oc",
            "opencode"
          ]
        },
        "harness": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "grok",
            "grok-acp",
            "kimi",
            "flue",
            "cursor",
            "opencode",
            "pi",
            "devin"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "placement": {
          "description": "Where a newly created harness session lives. Background is Scout-managed (default); foreground is openable in the operator's native harness UI. Codex supports foreground. Attached means a terminal-backed session; an existing session must already match the requested placement.",
          "type": "string",
          "enum": [
            "background",
            "foreground",
            "attached"
          ]
        },
        "workspace": {
          "type": "string",
          "enum": [
            "same",
            "new_worktree"
          ]
        },
        "session": {
          "description": "Compatibility hint. Agent-card targets are always fresh-session requests; use targetSessionId to continue exact prior context.",
          "type": "string",
          "enum": [
            "reuse",
            "new"
          ]
        },
        "wait": {
          "description": "Compatibility alias for replyMode='inline'.",
          "type": "boolean"
        }
      },
      "required": [
        "body"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
