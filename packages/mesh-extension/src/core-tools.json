  {
    "name": "invocations_wait",
    "title": "Wait For Scout Task",
    "description": "Wait briefly for a previously-created Scout task to finish, then return the latest flight state. This is a bounded follow-up wait, not the long-running ask submission path.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "currentDirectory": {
