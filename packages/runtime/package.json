  "files": [
    "bin",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/test-helpers/**",
    "drizzle",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run --cwd ../agent-sessions build && rm -rf dist && node_modules/.bin/tsc -p tsconfig.json",
    "broker": "node ./bin/openscout-runtime.mjs broker",
    "service": "node ./bin/openscout-runtime.mjs service",
    "discover": "node ./bin/openscout-runtime.mjs discover",
    "db:generate": "bunx drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun ./src/drizzle-migrate.ts",
    "check": "bun run --cwd ../agent-sessions build && tsc --noEmit -p tsconfig.json",
    "test": "bun test src/*.test.ts",
    "test:conformance": "OPENSCOUT_CONFORMANCE=1 bun test src/system-probes.test.ts --test-name-pattern='scoutd conformance diff harness'",
    "test:scenarios": "bun test src/scenario-suite.test.ts",
    "test:live:jetstream": "bun test src/jetstream/*live.test.ts",
    "test:live:codex-app-server": "bun test src/codex-app-server-live.test.ts",
    "test:live:opencode-acp": "bun test src/opencode-acp-live.test.ts",
    "test:e2e:local-agent-pass": "bash ../../scripts/run-live-local-agent-pass.sh",
    "test:live:local-agent-pass": "bash ../../scripts/run-live-local-agent-pass.sh",
    "prepack": "bun run build && node ../../scripts/prepare-publish-manifest.mjs .",
    "postpack": "node ../../scripts/restore-publish-manifest.mjs .",
    "postpublish": "node ../../scripts/restore-publish-manifest.mjs ."
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@openscout/agent-sessions": "workspace:*",
    "@openscout/protocol": "workspace:*",
    "@peculiar/x509": "1.12.3",
    "@trpc/server": "^11.16.0",
    "bonjour-service": "^1.4.4",
    "drizzle-orm": "^0.45.2",
    "ipaddr.js": "2.2.0",
    "protobufjs": "7.6.6",
    "smol-toml": "^1.6.1",
    "standardwebhooks": "1.0.0",
    "varlock": "^1.16.0",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cursor/sdk": "1.0.13",
    "@types/node": "^22",
    "@types/ws": "^8.5.13",
    "bun-types": "^1.3.11",
    "drizzle-kit": "0.31.10",
    "typescript": "^5"
  },
